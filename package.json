{
  "name": "@bluzzi/eslint-config",
  "description": "ESLint configuration preset for linting and formatting all your files",
  "version": "2.1.0",
  "license": "MIT",
  "author": "Bluzzi",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build:config": "tsup src/index.ts --minify --format esm --clean --dts",
    "build:type": "tsx ./scripts/typegen.ts",
    "inspector:dev": "npx @eslint/config-inspector --config eslint.config.js",
    "inspector:build": "npm run build:config && npx @eslint/config-inspector build",
    "inspector:start": "serve .eslint-config-inspector",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ts:check": "tsc --noEmit"
  },
  "homepage": "https://github.com/Bluzzi/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/Bluzzi/eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bluzzi/eslint-config.git"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^1.34.1",
    "@eslint/js": "^9.22.0",
    "@next/eslint-plugin-next": "^15.2.2",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint-flat-config-utils": "^2.0.1",
    "eslint-plugin-antfu": "^3.1.1",
    "eslint-plugin-n": "^17.16.2",
    "eslint-plugin-perfectionist": "^4.10.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "local-pkg": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^1.0.2",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-typegen": "^2.1.0",
    "serve": "^14.2.4",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "keywords": [
    "eslint",
    "config",
    "typescript",
    "react",
    "stylistic",
    "node"
  ]
}