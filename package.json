{
  "name": "@bluzzi/eslint-config",
  "description": "ESLint configuration preset for linting and formatting all your files",
  "version": "2.2.4",
  "license": "MIT",
  "author": "Bluzzi",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build:config": "tsup src/index.ts --minify --format esm --clean --dts",
    "build:type": "tsx ./scripts/typegen.ts",
    "inspector:dev": "npx @eslint/config-inspector --config eslint.config.js",
    "inspector:build": "npm run build:config && npx @eslint/config-inspector build",
    "inspector:start": "serve .eslint-config-inspector",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ts:check": "tsc --noEmit"
  },
  "homepage": "https://github.com/Bluzzi/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/Bluzzi/eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bluzzi/eslint-config.git"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-plugin-antfu": "^3.3.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "local-pkg": "^1.2.1"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^3.5.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-typegen": "^2.3.1",
    "serve": "^14.2.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "keywords": [
    "eslint",
    "config",
    "typescript",
    "react",
    "stylistic",
    "node"
  ]
}