{
  "name": "@bluzzi/eslint-config",
  "description": "ESLint configuration preset for linting and formatting all your files",
  "version": "2.1.1",
  "license": "MIT",
  "author": "Bluzzi",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build:config": "tsup src/index.ts --minify --format esm --clean --dts",
    "build:type": "tsx ./scripts/typegen.ts",
    "inspector:dev": "npx @eslint/config-inspector --config eslint.config.js",
    "inspector:build": "npm run build:config && npx @eslint/config-inspector build",
    "inspector:start": "serve .eslint-config-inspector",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ts:check": "tsc --noEmit"
  },
  "homepage": "https://github.com/Bluzzi/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/Bluzzi/eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bluzzi/eslint-config.git"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^2.12.2",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.1.6",
    "@stylistic/eslint-plugin": "^5.8.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint-flat-config-utils": "^3.0.1",
    "eslint-plugin-antfu": "^3.2.0",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-perfectionist": "^5.5.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "local-pkg": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^1.4.2",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.2.2",
    "eslint": "^10.0.0",
    "eslint-typegen": "^2.3.0",
    "serve": "^14.2.5",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "keywords": [
    "eslint",
    "config",
    "typescript",
    "react",
    "stylistic",
    "node"
  ]
}